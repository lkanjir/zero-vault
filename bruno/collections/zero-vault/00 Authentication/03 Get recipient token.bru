meta {
  name: 03 Get recipient token
  type: http
  seq: 3
}

post {
  url: {{oidcIssuer}}/protocol/openid-connect/token
  body: formUrlEncoded
  auth: none
}

headers {
  Accept: application/json
  Content-Type: application/x-www-form-urlencoded
}

body:form-urlencoded {
  grant_type: password
  client_id: {{clientId}}
  username: {{recipientUsername}}
  password: {{recipientPassword}}
  scope: openid
}

script:post-response {
  if (res.status === 200) {
    bru.setGlobalEnvVar('recipientAccessToken', res.body.access_token);
  }
}

tests {
  test('returns a recipient access token', function () {
    expect(res.status).to.equal(200);
    expect(res.body.access_token).to.be.a('string');
  });
}
