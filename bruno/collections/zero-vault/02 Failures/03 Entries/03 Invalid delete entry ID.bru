meta {
  name: 03 Invalid delete entry ID
  type: http
  seq: 3
}

delete {
  url: {{apiBaseUrl}}/api/entries/not-a-uuid
  body: none
  auth: bearer
}

auth:bearer {
  token: {{ownerAccessToken}}
}

tests {
  test('rejects an invalid entry path parameter', function () {
    expect(res.status).to.equal(400);
    expect(res.body.code).to.equal('invalid_request_params');
  });
}
