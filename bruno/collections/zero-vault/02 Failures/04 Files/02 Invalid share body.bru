meta {
  name: 02 Invalid share body
  type: http
  seq: 2
}

post {
  url: {{apiBaseUrl}}/api/files/00000000-0000-4000-8000-000000000001/shares
  body: json
  auth: bearer
}

auth:bearer {
  token: {{ownerAccessToken}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "recipientEmail": "not-an-email",
    "permission": "owner",
    "expiresAt": "tomorrow"
  }
}

tests {
  test('rejects invalid share fields before authorization', function () {
    expect(res.status).to.equal(400);
    expect(res.body.code).to.equal('invalid_request_body');
    expect(res.body.details.issues).to.be.an('array');
  });
}
