meta {
  name: 06 Invalid shared-with-me query
  type: http
  seq: 6
}

get {
  url: {{apiBaseUrl}}/api/files/shared-with-me?cursor=%20%20%20&limit=101
  body: none
  auth: bearer
}

auth:bearer {
  token: {{ownerAccessToken}}
}

tests {
  test('rejects invalid shared-with-me pagination', function () {
    expect(res.status).to.equal(400);
    expect(res.body.code).to.equal('invalid_request_query');
  });
}
