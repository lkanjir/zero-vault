meta {
  name: 04 Invalid revoke share ID
  type: http
  seq: 4
}

delete {
  url: {{apiBaseUrl}}/api/files/00000000-0000-4000-8000-000000000001/shares/not-a-uuid
  body: none
  auth: bearer
}

auth:bearer {
  token: {{ownerAccessToken}}
}

tests {
  test('rejects an invalid share path parameter', function () {
    expect(res.status).to.equal(400);
    expect(res.body.code).to.equal('invalid_request_params');
  });
}
