meta {
  name: 01 Invalid download file ID
  type: http
  seq: 1
}

post {
  url: {{apiBaseUrl}}/api/files/not-a-uuid/download-url
  body: none
  auth: bearer
}

auth:bearer {
  token: {{ownerAccessToken}}
}

tests {
  test('rejects an invalid download file ID', function () {
    expect(res.status).to.equal(400);
    expect(res.body.code).to.equal('invalid_request_params');
  });
}
