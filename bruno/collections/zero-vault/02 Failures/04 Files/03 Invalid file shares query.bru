meta {
  name: 03 Invalid file shares query
  type: http
  seq: 3
}

get {
  url: {{apiBaseUrl}}/api/files/00000000-0000-4000-8000-000000000001/shares?limit=0
  body: none
  auth: bearer
}

auth:bearer {
  token: {{ownerAccessToken}}
}

tests {
  test('rejects invalid share-list pagination', function () {
    expect(res.status).to.equal(400);
    expect(res.body.code).to.equal('invalid_request_query');
  });
}
