meta {
  name: 07 Invalid replacement body
  type: http
  seq: 7
}

post {
  url: {{apiBaseUrl}}/api/files/00000000-0000-4000-8000-000000000001/replacements
  body: json
  auth: bearer
}

auth:bearer {
  token: {{ownerAccessToken}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "contentType": "; charset=utf-8",
    "size": 0,
    "sha256": "invalid"
  }
}

tests {
  test('rejects invalid replacement metadata before authorization', function () {
    expect(res.status).to.equal(400);
    expect(res.body.code).to.equal('invalid_request_body');
    expect(res.body.details.issues).to.be.an('array');
  });
}
