meta {
  name: 01 Invalid create folder body
  type: http
  seq: 1
}

post {
  url: {{apiBaseUrl}}/api/folders
  body: json
  auth: bearer
}

auth:bearer {
  token: {{ownerAccessToken}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "parentId": "not-a-uuid",
    "name": "../invalid-folder"
  }
}

tests {
  test('rejects invalid folder fields', function () {
    expect(res.status).to.equal(400);
    expect(res.body.code).to.equal('invalid_request_body');
    expect(res.body.details.issues).to.be.an('array');
  });
}
