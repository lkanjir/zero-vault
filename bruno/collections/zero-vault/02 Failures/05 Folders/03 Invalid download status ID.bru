meta {
  name: 03 Invalid download status ID
  type: http
  seq: 3
}

get {
  url: {{apiBaseUrl}}/api/folders/downloads/not-a-uuid
  body: none
  auth: bearer
}

auth:bearer {
  token: {{ownerAccessToken}}
}

tests {
  test('rejects an invalid folder-download status path parameter', function () {
    expect(res.status).to.equal(400);
    expect(res.body.code).to.equal('invalid_request_params');
  });
}
