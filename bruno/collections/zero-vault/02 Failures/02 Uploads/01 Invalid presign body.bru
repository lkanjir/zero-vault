meta {
  name: 01 Invalid presign body
  type: http
  seq: 1
}

post {
  url: {{apiBaseUrl}}/api/uploads/presign
  body: json
  auth: bearer
}

auth:bearer {
  token: {{ownerAccessToken}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "parentFolderId": "not-a-uuid",
    "fileName": "../invalid.txt",
    "contentType": "text/plain",
    "size": 0,
    "sha256": "not-a-sha256"
  }
}

tests {
  test('reports all invalid upload fields as a body validation error', function () {
    expect(res.status).to.equal(400);
    expect(res.body.code).to.equal('invalid_request_body');
    expect(res.body.details.issues).to.be.an('array');
  });
}
