meta {
  name: 01 Missing access token
  type: http
  seq: 1
}

get {
  url: {{apiBaseUrl}}/api/entries
  body: none
  auth: none
}

tests {
  test('returns the standard authentication-required response', function () {
    expect(res.status).to.equal(401);
    expect(res.body.code).to.equal('authentication_required');
    expect(res.headers['www-authenticate']).to.equal('Bearer');
  });
}
