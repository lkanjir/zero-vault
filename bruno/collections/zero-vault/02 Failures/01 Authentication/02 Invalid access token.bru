meta {
  name: 02 Invalid access token
  type: http
  seq: 2
}

get {
  url: {{apiBaseUrl}}/api/entries
  body: none
  auth: bearer
}

auth:bearer {
  token: not-a-valid-jwt
}

tests {
  test('returns the standard invalid-token response', function () {
    expect(res.status).to.equal(401);
    expect(res.body.code).to.equal('invalid_access_token');
    expect(res.headers['www-authenticate']).to.equal('Bearer error="invalid_token"');
  });
}
