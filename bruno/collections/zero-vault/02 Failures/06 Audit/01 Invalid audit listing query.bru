meta {
  name: 01 Invalid audit listing query
  type: http
  seq: 1
}

get {
  url: {{apiBaseUrl}}/api/audit/events?limit=0
  body: none
  auth: bearer
}

auth:bearer {
  token: {{ownerAccessToken}}
}

tests {
  test('rejects an invalid audit listing limit', function () {
    expect(res.status).to.equal(400);
    expect(res.body.code).to.equal('invalid_request_query');
  });
}
