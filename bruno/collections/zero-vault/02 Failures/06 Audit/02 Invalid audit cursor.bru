meta {
  name: 02 Invalid audit cursor
  type: http
  seq: 2
}

get {
  url: {{apiBaseUrl}}/api/audit/events?cursor=not-a-cursor
  body: none
  auth: bearer
}

auth:bearer {
  token: {{ownerAccessToken}}
}

tests {
  test('rejects a malformed audit cursor', function () {
    expect(res.status).to.equal(400);
    expect(res.body.code).to.equal('invalid_cursor');
  });
}
