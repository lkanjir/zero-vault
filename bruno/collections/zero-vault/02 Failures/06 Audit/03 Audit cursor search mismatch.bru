meta {
  name: 03 Audit cursor search mismatch
  type: http
  seq: 3
}

get {
  url: {{apiBaseUrl}}/api/audit/events?limit=5&cursor={{auditCursor}}&search={{demoRunId}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{ownerAccessToken}}
}

tests {
  test('rejects a cursor created for different search criteria', function () {
    expect(res.status).to.equal(400);
    expect(res.body.code).to.equal('invalid_cursor');
  });
}
