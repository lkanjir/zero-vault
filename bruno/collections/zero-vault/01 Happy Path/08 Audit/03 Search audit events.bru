meta {
  name: 03 Search audit events
  type: http
  seq: 3
}

get {
  url: {{apiBaseUrl}}/api/audit/events?limit=100&search={{demoRunId}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{ownerAccessToken}}
}

tests {
  test('finds audit events by the entry name snapshot', function () {
    expect(res.status).to.equal(200);
    expect(res.body.items).to.be.an('array').and.not.empty;

    const runId = bru.getGlobalEnvVar('demoRunId');
    const unrelatedEvent = res.body.items.find((event) => !event.entry.name.includes(runId));
    expect(unrelatedEvent).to.equal(undefined);
  });

  test('includes the completed demo operations', function () {
    const actions = new Set(res.body.items.map((event) => event.action));
    expect(actions.has('folder.created')).to.equal(true);
    expect(actions.has('file.uploaded')).to.equal(true);
    expect(actions.has('entry.deleted')).to.equal(true);
  });
}
