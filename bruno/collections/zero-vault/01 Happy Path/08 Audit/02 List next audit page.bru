meta {
  name: 02 List next audit page
  type: http
  seq: 2
}

get {
  url: {{apiBaseUrl}}/api/audit/events?limit=5&cursor={{auditCursor}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{ownerAccessToken}}
}

tests {
  test('continues audit listing without repeating the first page', function () {
    expect(res.status).to.equal(200);
    expect(res.body.items).to.be.an('array').and.not.empty;
    expect(res.body.page.limit).to.equal(5);

    const firstPageIds = JSON.parse(bru.getGlobalEnvVar('auditFirstPageIds'));
    const repeatedEvent = res.body.items.find((event) => firstPageIds.includes(event.id));
    expect(repeatedEvent).to.equal(undefined);
  });
}
