meta {
  name: 03 Create replacement intent
  type: http
  seq: 3
}

post {
  url: {{apiBaseUrl}}/api/files/{{fileId}}/replacements
  body: json
  auth: bearer
}

auth:bearer {
  token: {{ownerAccessToken}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "contentType": "text/plain",
    "size": 27,
    "sha256": "24883a042b2bbc014d52e6597d9cbbf6796efc26b480f59eddd22d242eed7ee0"
  }
}

script:post-response {
  if (res.status === 201) {
    bru.setGlobalEnvVar('replacementUploadId', res.body.uploadId);
    bru.setGlobalEnvVar('replacementUploadUrl', res.body.uploadUrl);
    bru.setGlobalEnvVar(
      'replacementRequiredContentType',
      res.body.requiredHeaders['Content-Type']
    );
    bru.setGlobalEnvVar(
      'replacementChecksumBase64',
      res.body.requiredHeaders['x-amz-checksum-sha256']
    );
  }
}

tests {
  test('creates a replacement upload intent for the existing file', function () {
    expect(res.status).to.equal(201);
    expect(res.body.uploadId).to.be.a('string');
    expect(res.body.uploadUrl).to.be.a('string');
    expect(res.body.requiredHeaders['Content-Type']).to.equal('text/plain');
    expect(res.body.requiredHeaders['x-amz-checksum-sha256'])
      .to.equal('JIg6BCsrvAFNUuZZfZy79nlu/Ca0gPWe3dItJC7tfuA=');
  });
}
