meta {
  name: 09 Create replaced file download URL
  type: http
  seq: 9
}

post {
  url: {{apiBaseUrl}}/api/files/{{fileId}}/download-url
  body: none
  auth: bearer
}

auth:bearer {
  token: {{ownerAccessToken}}
}

script:post-response {
  if (res.status === 200) {
    bru.setGlobalEnvVar('replacementDownloadUrl', res.body.downloadUrl);
  }
}

tests {
  test('creates a download URL for the replaced object', function () {
    expect(res.status).to.equal(200);
    expect(res.body.fileId).to.equal(bru.getGlobalEnvVar('fileId'));
    expect(res.body.contentType).to.equal('text/plain');
    expect(res.body.sizeBytes).to.equal(27);
    expect(res.body.downloadUrl).to.be.a('string');
  });
}
