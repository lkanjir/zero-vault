meta {
  name: 08 Reject stale replacement completion
  type: http
  seq: 8
}

post {
  url: {{apiBaseUrl}}/api/uploads/{{staleReplacementUploadId}}/complete
  body: none
  auth: bearer
}

auth:bearer {
  token: {{ownerAccessToken}}
}

tests {
  test('rejects an intent based on a superseded content version', function () {
    expect(res.status).to.equal(409);
    expect(res.body.code).to.equal('replacement_conflict');
  });
}
