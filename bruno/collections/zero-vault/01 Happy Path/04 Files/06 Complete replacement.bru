meta {
  name: 06 Complete replacement
  type: http
  seq: 6
}

post {
  url: {{apiBaseUrl}}/api/uploads/{{replacementUploadId}}/complete
  body: none
  auth: bearer
}

auth:bearer {
  token: {{ownerAccessToken}}
}

tests {
  test('atomically replaces the existing file content', function () {
    expect(res.status).to.equal(200);
    expect(res.body.kind).to.equal('file');
    expect(res.body.id).to.equal(bru.getGlobalEnvVar('fileId'));
    expect(res.body.name)
      .to.equal(`bruno-renamed-${bru.getGlobalEnvVar('demoRunId')}.txt`);
    expect(res.body.contentType).to.equal('text/plain');
    expect(res.body.sizeBytes).to.equal(27);
  });
}
