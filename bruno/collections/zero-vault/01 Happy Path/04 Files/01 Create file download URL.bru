meta {
  name: 01 Create file download URL
  type: http
  seq: 1
}

post {
  url: {{apiBaseUrl}}/api/files/{{fileId}}/download-url
  body: none
  auth: bearer
}

auth:bearer {
  token: {{ownerAccessToken}}
}

script:post-response {
  if (res.status === 200) {
    bru.setGlobalEnvVar('fileDownloadUrl', res.body.downloadUrl);
  }
}

tests {
  test('creates a presigned file download URL', function () {
    expect(res.status).to.equal(200);
    expect(res.body.fileId).to.equal(bru.getGlobalEnvVar('fileId'));
    expect(res.body.downloadUrl).to.be.a('string');
    expect(res.body.sizeBytes).to.equal(23);
  });
}
