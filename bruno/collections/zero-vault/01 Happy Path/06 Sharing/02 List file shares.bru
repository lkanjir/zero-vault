meta {
  name: 02 List file shares
  type: http
  seq: 2
}

get {
  url: {{apiBaseUrl}}/api/files/{{fileId}}/shares?limit=50
  body: none
  auth: bearer
}

auth:bearer {
  token: {{ownerAccessToken}}
}

script:post-response {
  if (res.status === 200) {
    const recipientEmail = String(bru.getGlobalEnvVar('recipientEmail')).toLowerCase();
    const share = res.body.items.find((item) => item.recipientEmail === recipientEmail);
    if (share) {
      bru.setGlobalEnvVar('shareId', share.shareId);
    }
  }
}

tests {
  test('lists the viewer grant for the recipient', function () {
    expect(res.status).to.equal(200);
    const recipientEmail = String(bru.getGlobalEnvVar('recipientEmail')).toLowerCase();
    const share = res.body.items.find((item) => item.recipientEmail === recipientEmail);
    expect(share).to.be.an('object');
    expect(share.permission).to.equal('viewer');
  });
}
