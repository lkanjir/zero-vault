meta {
  name: 12 Editor completes replacement
  type: http
  seq: 12
}

post {
  url: {{apiBaseUrl}}/api/uploads/{{editorReplacementUploadId}}/complete
  body: none
  auth: bearer
}

auth:bearer {
  token: {{recipientAccessToken}}
}

tests {
  test('allows the editor to replace the shared file content', function () {
    expect(res.status).to.equal(200);
    expect(res.body.kind).to.equal('file');
    expect(res.body.id).to.equal(bru.getGlobalEnvVar('fileId'));
    expect(res.body.name)
      .to.equal(`recipient-edited-${bru.getGlobalEnvVar('demoRunId')}.txt`);
    expect(res.body.contentType).to.equal('text/plain');
    expect(res.body.sizeBytes).to.equal(29);
  });
}
