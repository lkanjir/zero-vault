meta {
  name: 07 Recipient lists shared files as editor
  type: http
  seq: 7
}

get {
  url: {{apiBaseUrl}}/api/files/shared-with-me?limit=50
  body: none
  auth: bearer
}

auth:bearer {
  token: {{recipientAccessToken}}
}

tests {
  test('returns the updated editor capabilities', function () {
    expect(res.status).to.equal(200);
    const file = res.body.items.find((item) => item.id === bru.getGlobalEnvVar('fileId'));
    expect(file).to.be.an('object');
    expect(file.access.accessLevel).to.equal('editor');
    expect(file.access.capabilities.rename).to.equal(true);
    expect(file.access.capabilities.replaceContent).to.equal(true);
    expect(file.access.capabilities.delete).to.equal(false);
  });
}
