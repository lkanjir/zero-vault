meta {
  name: 07 Update share to editor with expiry
  type: http
  seq: 7
}

patch {
  url: {{apiBaseUrl}}/api/files/{{fileId}}/shares/{{shareId}}
  body: json
  auth: bearer
}

auth:bearer {
  token: {{ownerAccessToken}}
}

headers {
  Content-Type: application/json
}

script:pre-request {
  bru.setVar('grantExpiresAt', new Date(Date.now() + 24 * 60 * 60 * 1000).toISOString());
}

body:json {
  {
    "permission": "editor",
    "expiresAt": "{{grantExpiresAt}}"
  }
}

tests {
  test('updates the grant permission and expiry', function () {
    expect(res.status).to.equal(200);
    expect(res.body.shareId).to.equal(bru.getGlobalEnvVar('shareId'));
    expect(res.body.permission).to.equal('editor');
    expect(res.body.expiresAt).to.be.a('string');
  });
}
