meta {
  name: 04 Recipient creates download URL
  type: http
  seq: 4
}

post {
  url: {{apiBaseUrl}}/api/files/{{sharedFileId}}/download-url
  body: none
  auth: bearer
}

auth:bearer {
  token: {{recipientAccessToken}}
}

script:post-response {
  if (res.status === 200) {
    bru.setGlobalEnvVar('recipientDownloadUrl', res.body.downloadUrl);
  }
}

tests {
  test('allows a viewer to create a download URL', function () {
    expect(res.status).to.equal(200);
    expect(res.body.fileId).to.equal(bru.getGlobalEnvVar('fileId'));
  });
}
