meta {
  name: 10 Editor creates replacement intent
  type: http
  seq: 10
}

post {
  url: {{apiBaseUrl}}/api/files/{{sharedFileId}}/replacements
  body: json
  auth: bearer
}

auth:bearer {
  token: {{recipientAccessToken}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "contentType": "text/plain",
    "size": 29,
    "sha256": "85e8bb542651337c8b83fe78d97e7213789749f6e275836d0ba6d8cf0df0423e"
  }
}

script:post-response {
  if (res.status === 201) {
    bru.setGlobalEnvVar('editorReplacementUploadId', res.body.uploadId);
    bru.setGlobalEnvVar('editorReplacementUploadUrl', res.body.uploadUrl);
    bru.setGlobalEnvVar(
      'editorReplacementRequiredContentType',
      res.body.requiredHeaders['Content-Type']
    );
    bru.setGlobalEnvVar(
      'editorReplacementChecksumBase64',
      res.body.requiredHeaders['x-amz-checksum-sha256']
    );
  }
}

tests {
  test('allows an editor to create a replacement intent', function () {
    expect(res.status).to.equal(201);
    expect(res.body.uploadId).to.be.a('string');
    expect(res.body.uploadUrl).to.be.a('string');
    expect(res.body.requiredHeaders['x-amz-checksum-sha256'])
      .to.equal('hei7VCZRM3yLg/542X5yE3iXSfbidYNtC6bYzw3wQj4=');
  });
}
