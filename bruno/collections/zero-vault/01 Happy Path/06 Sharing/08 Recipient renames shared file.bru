meta {
  name: 08 Recipient renames shared file
  type: http
  seq: 8
}

patch {
  url: {{apiBaseUrl}}/api/entries/{{sharedFileId}}
  body: json
  auth: bearer
}

auth:bearer {
  token: {{recipientAccessToken}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "name": "recipient-edited-{{demoRunId}}.txt"
  }
}

tests {
  test('allows an editor to rename the shared file', function () {
    expect(res.status).to.equal(200);
    expect(res.body.id).to.equal(bru.getGlobalEnvVar('fileId'));
    expect(res.body.name).to.equal(`recipient-edited-${bru.getGlobalEnvVar('demoRunId')}.txt`);
  });
}
