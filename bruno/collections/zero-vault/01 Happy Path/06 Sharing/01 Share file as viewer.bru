meta {
  name: 01 Share file as viewer
  type: http
  seq: 1
}

post {
  url: {{apiBaseUrl}}/api/files/{{fileId}}/shares
  body: json
  auth: bearer
}

auth:bearer {
  token: {{ownerAccessToken}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "recipientEmail": "{{recipientEmail}}",
    "permission": "viewer",
    "expiresAt": null
  }
}

tests {
  test('accepts the share request without disclosing recipient state', function () {
    expect(res.status).to.equal(202);
    expect(res.body).to.deep.equal({ status: 'accepted' });
  });
}
