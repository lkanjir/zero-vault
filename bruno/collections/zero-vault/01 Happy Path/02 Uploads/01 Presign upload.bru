meta {
  name: 01 Presign upload
  type: http
  seq: 1
}

post {
  url: {{apiBaseUrl}}/api/uploads/presign
  body: json
  auth: bearer
}

auth:bearer {
  token: {{ownerAccessToken}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "parentFolderId": "{{sourceFolderId}}",
    "fileName": "bruno-demo-{{demoRunId}}.txt",
    "contentType": "text/plain",
    "size": 23,
    "sha256": "e24489a7ddd860f7d3c9483d85bdf40075f3f233c6e3a262fd9d4802fd9d1ab0"
  }
}

script:post-response {
  if (res.status === 201) {
    bru.setGlobalEnvVar('uploadId', res.body.uploadId);
    bru.setGlobalEnvVar('uploadUrl', res.body.uploadUrl);
    bru.setGlobalEnvVar('uploadRequiredContentType', res.body.requiredHeaders['Content-Type']);
    bru.setGlobalEnvVar('uploadChecksumBase64', res.body.requiredHeaders['x-amz-checksum-sha256']);
  }
}

tests {
  test('creates a single-part upload intent', function () {
    expect(res.status).to.equal(201);
    expect(res.body.uploadId).to.be.a('string');
    expect(res.body.uploadUrl).to.be.a('string');
    expect(res.body.requiredHeaders['x-amz-checksum-sha256'])
      .to.equal('4kSJp93YYPfTyUg9hb30AHXz8jPG46Ji/Z1IAv2dGrA=');
  });
}
