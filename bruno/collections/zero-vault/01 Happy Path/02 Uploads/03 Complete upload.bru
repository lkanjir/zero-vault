meta {
  name: 03 Complete upload
  type: http
  seq: 3
}

post {
  url: {{apiBaseUrl}}/api/uploads/{{uploadId}}/complete
  body: none
  auth: bearer
}

auth:bearer {
  token: {{ownerAccessToken}}
}

script:post-response {
  if (res.status === 200) {
    bru.setGlobalEnvVar('fileId', res.body.id);
  }
}

tests {
  test('completes the upload and creates a file entry', function () {
    expect(res.status).to.equal(200);
    expect(res.body.kind).to.equal('file');
    expect(res.body.id).to.be.a('string');
    expect(res.body.sizeBytes).to.equal(23);
  });
}
