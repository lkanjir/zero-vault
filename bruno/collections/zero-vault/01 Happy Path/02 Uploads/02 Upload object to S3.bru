meta {
  name: 02 Upload object to S3
  type: http
  seq: 2
}

put {
  url: {{uploadUrl}}
  body: text
  auth: none
}

headers {
  Content-Type: {{uploadRequiredContentType}}
  x-amz-checksum-sha256: {{uploadChecksumBase64}}
}

body:text {
  Zero Vault Bruno upload
}

tests {
  test('uploads the exact presigned object payload', function () {
    expect(res.status).to.be.oneOf([200, 204]);
  });
}
