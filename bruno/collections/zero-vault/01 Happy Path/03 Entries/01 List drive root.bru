meta {
  name: 01 List drive root
  type: http
  seq: 1
}

get {
  url: {{apiBaseUrl}}/api/entries?limit=50
  body: none
  auth: bearer
}

auth:bearer {
  token: {{ownerAccessToken}}
}

tests {
  test('lists the drive root and its page metadata', function () {
    expect(res.status).to.equal(200);
    expect(res.body.items).to.be.an('array');
    expect(res.body.path).to.deep.equal([]);
    expect(res.body.page.limit).to.equal(50);
  });
}
