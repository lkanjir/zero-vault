meta {
  name: 05 List target folder
  type: http
  seq: 5
}

get {
  url: {{apiBaseUrl}}/api/entries?parentId={{targetFolderId}}&limit=50
  body: none
  auth: bearer
}

auth:bearer {
  token: {{ownerAccessToken}}
}

tests {
  test('lists the moved file in the target folder', function () {
    expect(res.status).to.equal(200);
    expect(res.body.items.some((entry) => entry.id === bru.getGlobalEnvVar('fileId'))).to.equal(true);
    expect(res.body.path[res.body.path.length - 1].id).to.equal(bru.getGlobalEnvVar('targetFolderId'));
  });
}
