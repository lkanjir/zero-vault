meta {
  name: 03 Rename file
  type: http
  seq: 3
}

patch {
  url: {{apiBaseUrl}}/api/entries/{{fileId}}
  body: json
  auth: bearer
}

auth:bearer {
  token: {{ownerAccessToken}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "name": "bruno-renamed-{{demoRunId}}.txt"
  }
}

tests {
  test('renames the uploaded file', function () {
    expect(res.status).to.equal(200);
    expect(res.body.id).to.equal(bru.getGlobalEnvVar('fileId'));
    expect(res.body.name).to.equal(`bruno-renamed-${bru.getGlobalEnvVar('demoRunId')}.txt`);
  });
}
