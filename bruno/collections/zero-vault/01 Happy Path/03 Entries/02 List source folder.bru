meta {
  name: 02 List source folder
  type: http
  seq: 2
}

get {
  url: {{apiBaseUrl}}/api/entries?parentId={{sourceFolderId}}&limit=50
  body: none
  auth: bearer
}

auth:bearer {
  token: {{ownerAccessToken}}
}

tests {
  test('lists the uploaded file in its source folder', function () {
    expect(res.status).to.equal(200);
    expect(res.body.items.some((entry) => entry.id === bru.getGlobalEnvVar('fileId'))).to.equal(true);
    expect(res.body.path[res.body.path.length - 1].id).to.equal(bru.getGlobalEnvVar('sourceFolderId'));
  });
}
