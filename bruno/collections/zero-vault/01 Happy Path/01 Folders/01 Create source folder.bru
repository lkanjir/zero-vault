meta {
  name: 01 Create source folder
  type: http
  seq: 1
}

post {
  url: {{apiBaseUrl}}/api/folders
  body: json
  auth: bearer
}

auth:bearer {
  token: {{ownerAccessToken}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "parentId": null,
    "name": "Bruno source {{demoRunId}}"
  }
}

script:post-response {
  if (res.status === 201) {
    bru.setGlobalEnvVar('sourceFolderId', res.body.id);
  }
}

tests {
  test('creates a source folder in drive root', function () {
    expect(res.status).to.equal(201);
    expect(res.body.kind).to.equal('folder');
    expect(res.body.id).to.be.a('string');
  });
}
