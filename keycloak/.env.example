KEYCLOAK_VERSION=26.7.0

KEYCLOAK_DB_NAME=keycloak
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=change-me-local-only

KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=change-me-local-only

ZERO_VAULT_SSL_REQUIRED=external
ZERO_VAULT_WEB_ORIGIN=http://localhost:4200
ZERO_VAULT_WEB_REDIRECT_URI=http://localhost:4200/*
ZERO_VAULT_WEB_POST_LOGOUT_REDIRECT_URI=http://localhost:4200/*

ZERO_VAULT_SMTP_FROM=noreply@zero-vault.local
ZERO_VAULT_SMTP_HOST=mailpit
ZERO_VAULT_SMTP_PORT=1025
ZERO_VAULT_SMTP_AUTH=false
ZERO_VAULT_SMTP_STARTTLS=false
ZERO_VAULT_SMTP_SSL=false
ZERO_VAULT_SMTP_USER=
ZERO_VAULT_SMTP_PASSWORD=
