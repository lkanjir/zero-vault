PORT=3000

S3_ENDPOINT=http://localhost:4566
S3_PUBLIC_ORIGIN=http://localhost:4566
S3_REGION=eu-central-1
S3_FORCE_PATH_STYLE=true

S3_ACCESS_KEY_ID=test
S3_SECRET_ACCESS_KEY=test

S3_BUCKET=zero-vault

DATABASE_URL="postgresql://api:strong-password@localhost:5432/zerovault"
REDIS_URL=redis://localhost:6379

OIDC_ISSUER=http://localhost:8080/realms/zero-vault
OIDC_AUDIENCE=zero-vault-api
OIDC_CLIENT_ID=zero-vault-web

HSTS_ENABLED=false
TRUST_PROXY=false
