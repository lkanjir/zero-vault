{
  "name": "backend",
  "version": "1.0.0",
  "description": "",
  "main": "dist/server.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "typecheck:test": "tsc --noEmit -p tests/tsconfig.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write . --config ../.prettierrc --ignore-path ../.prettierignore",
    "format:check": "prettier --check . --config ../.prettierrc --ignore-path ../.prettierignore",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "check": "npm run typecheck && npm run lint && npm run format:check",
    "test:unit": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:watch": "vitest",
    "test": "npm run check && npm run typecheck:test && npm run test:unit && npm run test:integration",
    "dev:upload-cleanup": "tsx watch src/workers/upload-cleanup-worker.ts",
    "start:upload-cleanup": "node dist/workers/upload-cleanup-worker.js",
    "dev:folder-download": "tsx watch src/workers/folder-download-worker.ts",
    "start:folder-download": "node dist/workers/folder-download-worker.js",
    "dev:object-deletion": "tsx watch src/workers/object-deletion-worker.ts",
    "start:object-deletion": "node dist/workers/object-deletion-worker.js"
  },
  "keywords": [],
  "author": "Luka Kanjir",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1073.0",
    "@aws-sdk/lib-storage": "^3.1090.0",
    "@aws-sdk/s3-request-presigner": "^3.1073.0",
    "archiver": "^8.0.0",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "express": "^5.2.1",
    "jose": "^6.2.3",
    "node-cron": "^4.6.0",
    "pg": "^8.22.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testcontainers/postgresql": "^12.0.4",
    "@types/archiver": "^8.0.0",
    "@types/express": "^5.0.6",
    "@types/node": "^26.0.0",
    "@types/pg": "^8.20.0",
    "@types/supertest": "^7.2.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.5.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.8.4",
    "supertest": "^7.2.2",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1",
    "vitest": "^4.1.9",
    "vitest-mock-extended": "^4.0.0"
  }
}
